{
  "normal_push_gating": {
    "release_steps": [
      "Check unresolved draft releases",
      "Run release-please"
    ],
    "production_condition_terms": [
      "needs.release.outputs.release_created == 'true'",
      "needs.release.outputs.tag_name != ''"
    ]
  },
  "automatic_release": {
    "ordered_steps": [
      "Resolve release request",
      "Checkout selected release tag",
      "Resolve controller image plan",
      "Reconcile release manifest",
      "Recheck controller digest before full deployment",
      "Terraform apply",
      "Run full deployment",
      "Verify deployment health",
      "Validate release completion gate",
      "Commit production release status",
      "Publish GitHub Release"
    ]
  },
  "retry_automation_checkout": {
    "release_source_step": "Checkout selected release tag",
    "retry_automation_step": "Checkout dispatched main retry guard",
    "recovery_step": "Prepare retry recovery contract",
    "automation_path": ".retry-automation",
    "sparse_paths": [
      "scripts/retry_recovery.py",
      "scripts/retry-recovery-contracts.json"
    ],
    "allowed_path": "deploy/ansible/roles/autographs_deploy/tasks/validate_kernel_boot_entry.yml",
    "forbidden_paths": [
      "deploy/ansible/roles/autographs_deploy/defaults/main.yml",
      "deploy/ansible/roles/autographs_deploy/templates/app.env.j2",
      "deploy/ansible/roles/autographs_deploy/files/Caddyfile",
      "deploy/ansible/roles/autographs_deploy/tasks/main.yml"
    ]
  },
  "unresolved_draft_block": {
    "step": "Check unresolved draft releases",
    "required_run_terms": [
      "scripts/release.py preflight-drafts",
      "gh workflow run deploy.yml --ref main -f operation=retry -f release_tag="
    ]
  },
  "retry_draft_lookup": {
    "step": "Resolve release request",
    "required_run_terms": [
      "isDraft",
      "Retry requires an unresolved draft release"
    ]
  },
  "draft_manifest_asset_lookup": {
    "steps": [
      "Load retry manifest when present",
      "Reconcile release manifest"
    ],
    "required_run_terms": [
      "gh release view \"$RELEASE_TAG\" --json assets",
      "--jq '[.assets[] | select(.name == \"release-manifest.json\")] | length'"
    ],
    "forbidden_run_terms": [
      "/releases/tags/${RELEASE_TAG}"
    ]
  },
  "published_manifest_rollback": {
    "ordered_steps": [
      "Checkout current main for controller rollback",
      "Load published rollback manifest",
      "Recheck controller digest before rollback",
      "Run controller-only rollback",
      "Commit production release status"
    ]
  },
  "identical_versus_conflicting_manifest_assets": {
    "step": "Reconcile release manifest",
    "required_run_terms": [
      "scripts/release.py reconcile-asset",
      "gh release upload",
      "release-manifest.json"
    ],
    "forbidden_run_terms": [
      "--clobber"
    ]
  },
  "current_main_no_terraform_controller_rollback": {
    "checkout_step": "Checkout current main for controller rollback",
    "playbook_step": "Run controller-only rollback",
    "playbook": "playbooks/controller-rollback.yml",
    "forbidden_step": "Terraform apply"
  },
  "immediate_pre_mutation_digest_verification": {
    "pairs": [
      [
        "Recheck controller digest before full deployment",
        "Terraform apply"
      ],
      [
        "Recheck controller digest before rollback",
        "Run controller-only rollback"
      ]
    ]
  }
}
