# GitHub Actions configuration contract.
# Populate these as repo-level GitHub Secrets or GitHub Variables as noted.
# Optional GitHub Environments may layer approvals on top, but the baseline
# workflow expects repo-level values.

## Repo-level GitHub Secrets

# Private key for the repository-installed release-please GitHub App. The App
# has only Contents and Pull requests read/write; the workflow uses this key to
# mint a repository-scoped installation token that expires after one hour.
RELEASE_PLEASE_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----..."

OCI_CLI_USER_OCID=ocid1.user.oc1..replace_me
OCI_TENANCY_OCID=ocid1.tenancy.oc1..replace_me
OCI_FINGERPRINT=12:34:56:78:90:ab:cd:ef:12:34:56:78:90:ab:cd:ef
# Stored as a GitHub Secret. Deploy writes it to a protected VM file and passes
# OCI_PRIVATE_KEY_PATH to the Rust controller container; do not put this in git.
OCI_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----..."

DEPLOY_SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----..."
ORACLE_DB_WALLET_ZIP_BASE64="replace-with-base64-encoded-wallet-zip"
# Source values for approved Vault bootstrap and rotation. Normal deploys
# compare them with OCI Vault and refuse mismatches.
ORACLE_DB_WALLET_PASSWORD="replace-with-wallet-download-password"
AUTOGRAPHS_ADMIN_PASSWORD_HASH='replace-with-existing-argon2id-hash'
RUNTIME_SECRET_ROTATION_AUTH_KEY="replace-with-random-key-from-openssl-rand-hex-32"
AUTOGRAPHS_OPERATOR_API_TOKEN="replace-with-random-operator-token"
CLOUDFLARE_API_TOKEN=

## Repo-level GitHub Variables

# Client ID for the repository-installed release-please GitHub App.
RELEASE_PLEASE_APP_CLIENT_ID=Iv1.replace-with-github-app-client-id

OCI_AVAILABILITY_DOMAIN=replace-with-ashburn-ad
OCI_RUNTIME_IMAGE_OCID=ocid1.image.oc1..replace_me
OCI_RUNTIME_SSH_PUBLIC_KEYS='["ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIreplace_me github-actions@autographs"]'
OCI_OBJECT_STORAGE_NAMESPACE=replace-with-your-object-storage-namespace
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
# Optional override only: the default is proxied. Set dns_only for a reviewed proxy rollback or off for first bootstrap before Cloudflare exists.
# CLOUDFLARE_MODE=dns_only
ORACLE_DB_USER=ADMIN
ORACLE_DB_CONNECT_STRING="(description= (retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.us-ashburn-1.oraclecloud.com))(connect_data=(service_name=replace_me_medium.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))"
ORACLE_DB_WALLET_DIR=
AUTOGRAPHS_CONTROLLER_DB_PROVIDER=oracle
AUTOGRAPHS_CONTROLLER_MEDIA_STORAGE_PROVIDER=oci-instance-principal

VM_PUBLIC_IP=203.0.113.10
# Optional override for Ansible's opc SSH user default.
# DEPLOY_SSH_USER=alternate-user
# Optional override for Ansible's /opt/autographs runtime root. Set only for a coordinated fresh deployment or path migration.
# DEPLOY_PATH=/srv/autographs
DEPLOY_SSH_READY_TIMEOUT_SECONDS=900
DEPLOY_SSH_READY_INTERVAL_SECONDS=10
AUTOGRAPHS_DOMAIN=autographs.jetsaredim.net
GHCR_CONTROLLER_IMAGE_REPOSITORY=ghcr.io/jetsaredim/autographs/controller
GHCR_CLEANUP_RETAIN_TAGGED=10
GHCR_CLEANUP_MIN_AGE_DAYS=7
GHCR_CLEANUP_PROTECTED_TAGS=
AUTOGRAPHS_LOCAL_IMAGE_RETAIN_COUNT=3
