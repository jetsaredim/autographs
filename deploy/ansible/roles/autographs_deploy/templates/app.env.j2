AUTOGRAPHS_CONTROLLER_IMAGE={{ autographs_controller_image }}
AUTOGRAPHS_REPO_VERSION={{ autographs_deploy_repo_version }}
AUTOGRAPHS_CONTROLLER_VERSION={{ autographs_deploy_deployed_controller_version }}
AUTOGRAPHS_SOURCE_REVISION={{ autographs_deploy_source_revision }}
AUTOGRAPHS_DOMAIN={{ autographs_deploy_domain }}
AUTOGRAPHS_HTTP_PORT={{ autographs_deploy_http_port }}
AUTOGRAPHS_HTTPS_PORT={{ autographs_deploy_https_port }}
ORACLE_DB_USER={{ oracle_db_user | default('ADMIN') }}
ORACLE_DB_PASSWORD={{ lookup('env', 'ORACLE_DB_PASSWORD') | default('', true) }}
ORACLE_DB_CONNECT_STRING={{ oracle_db_connect_string | default('autographsdb_medium') }}
AUTOGRAPHS_ORACLE_HEARTBEAT_INTERVAL_SECONDS={{ autographs_oracle_heartbeat_interval_seconds | default(86400) }}
ORACLE_DB_WALLET_DIR=/opt/autographs/wallet
TNS_ADMIN=/opt/autographs/wallet
ORACLE_DB_WALLET_PASSWORD={{ lookup('env', 'ORACLE_DB_WALLET_PASSWORD') | default('', true) }}
AUTOGRAPHS_OPERATOR_API_TOKEN={{ autographs_operator_api_token | default(lookup('env', 'AUTOGRAPHS_OPERATOR_API_TOKEN') | default('', true), true) }}
AUTOGRAPHS_CONTROLLER_BIND_ADDR=0.0.0.0:{{ autographs_deploy_controller_port }}
AUTOGRAPHS_PUBLIC_ORIGIN=https://{{ autographs_deploy_domain }}
AUTOGRAPHS_ADMIN_SECURE_COOKIES=true
RUST_LOG={{ autographs_controller_rust_log | default('autographs_controller=info,tower_http=info', true) }}
AUTOGRAPHS_ADMIN_PASSWORD={{ autographs_deploy_admin_password_resolved | default('', true) }}
AUTOGRAPHS_ADMIN_PASSWORD_HASH={{ autographs_deploy_admin_password_hash_resolved | default('', true) }}
AUTOGRAPHS_STATIC_RELEASE_ROOT=/var/lib/autographs/static
OCI_REGION={{ oci_region | default('us-ashburn-1') }}
OCI_MEDIA_BUCKET_NAME={{ oci_media_bucket_name | default('autographs-media-prod') }}
OCI_MEDIA_NAMESPACE={{ oci_media_namespace | default(lookup('env', 'OCI_MEDIA_NAMESPACE') | default('', true), true) }}
