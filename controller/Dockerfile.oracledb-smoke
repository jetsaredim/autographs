FROM rust:1.97-bookworm AS builder

WORKDIR /workspace

COPY controller/Cargo.toml controller/Cargo.lock ./
COPY controller/src ./src
COPY controller/db ./db
COPY controller/tests ./tests
COPY controller/static-public ./static-public
COPY controller/static-admin ./static-admin

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/workspace/target,sharing=locked \
    cargo test --release --features oracledb-live-smoke --test live_oracledb_persistence_smoke --no-run \
    && smoke_binary="$(find target/release/deps -maxdepth 1 -type f -name 'live_oracledb_persistence_smoke-*' -perm -111 | head -n 1)" \
    && test -n "$smoke_binary" \
    && cp "$smoke_binary" /tmp/live-oracledb-persistence-smoke

FROM oraclelinux:10-slim

RUN microdnf install -y ca-certificates \
    && microdnf clean all

COPY --from=builder /tmp/live-oracledb-persistence-smoke /usr/local/bin/live-oracledb-persistence-smoke

ENV TNS_ADMIN=/opt/autographs/wallet

ENTRYPOINT ["/usr/local/bin/live-oracledb-persistence-smoke"]
CMD ["--ignored", "--nocapture"]
